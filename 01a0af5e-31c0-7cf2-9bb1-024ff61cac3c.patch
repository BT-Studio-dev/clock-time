+++ b/public/sw.js
@@ -0,0 +1,82 @@
+/**
+ * BT Clock service worker — installability + offline support.
+ *
+ * Strategies:
+ * - App shell (/, manifest, icons): precached on install.
+ * - Everything else on this origin: network-first — never stale while
+ *   online (safe with the dev server's HMR), cache fallback offline.
+ * - /music/*.mp3: cache-first after the first play. Range requests are
+ *   answered with the full 200 body (accepted by media elements), so a
+ *   track keeps working offline once it has been played.
+ */
+const VERSION = "system-space-v2";
+const SHELL = ["/", "/manifest.webmanifest", "/icon-192.png", "/icon-512.png", "/favicon.svg"];
+
+self.addEventListener("install", (event) => {
+  event.waitUntil(
+    (async () => {
+      const cache = await caches.open(VERSION);
+      await Promise.allSettled(SHELL.map((url) => cache.add(new Request(url, { cache: "reload" }))));
+      await self.skipWaiting();
+    })(),
+  );
+});
+
+self.addEventListener("activate", (event) => {
+  event.waitUntil(
+    (async () => {
+      const keys = await caches.keys();
+      await Promise.all(keys.filter((key) => key !== VERSION).map((key) => caches.delete(key)));
+      await self.clients.claim();
+    })(),
+  );
+});
+
+async function musicStrategy(pathname) {
+  const cache = await caches.open(VERSION);
+  const hit = await cache.match(pathname);
+  if (hit) return hit;
+  // Fetch the full body (no Range header) so the cached copy is complete.
+  const response = await fetch(new Request(pathname, { headers: { accept: "*/*" } }));
+  if (response.ok) await cache.put(pathname, response.clone());
+  return response;
+}
+
+self.addEventListener("message", (event) => {
+  if (event.data === "skip-waiting") self.skipWaiting();
+});
+
+self.addEventListener("fetch", (event) => {
+  const request = event.request;
+  if (request.method !== "GET") return;
+  const url = new URL(request.url);
+  if (url.origin !== self.location.origin) return;
+
+  if (url.pathname.startsWith("/music/")) {
+    event.respondWith(
+      musicStrategy(url.pathname).catch(() => caches.match("/").then((hit) => hit ?? Response.error())),
+    );
+    return;
+  }
+
+  event.respondWith(
+    (async () => {
+      try {
+        const response = await fetch(request);
+        if (response.ok) {
+          const cache = await caches.open(VERSION);
+          await cache.put(request, response.clone());
+        }
+        return response;
+      } catch {
+        const hit = await caches.match(request, { ignoreSearch: request.mode === "navigate" });
+        if (hit) return hit;
+        if (request.mode === "navigate") {
+          const home = await caches.match("/");
+          if (home) return home;
+        }
+        return Response.error();
+      }
+    })(),
+  );
+});
diff --git a/scripts/copy-pglite-data.mjs b/scripts/copy-pglite-data.mjs
new file mode 100644
index 0000000..332abdd
--- /dev/null
+++ b/scripts/copy-pglite-data.mjs
@@ -0,0 +1,35 @@
+#!/usr/bin/env node
+/**
+ * Node-server builds bundle @electric-sql/pglite into .output/server/_libs/
+ * but do not copy its binary sidecars (pglite.data / *.wasm), so the
+ * production server crashes on boot with ENOENT. Copy them next to the
+ * bundled module. Safe to run repeatedly; exits 0 when there is nothing
+ * to do (e.g. Vercel preset, no _libs dir, or files already present).
+ */
+import { copyFileSync, existsSync, readdirSync } from "node:fs";
+import { join } from "node:path";
+
+const libs = join(process.cwd(), ".output", "server", "_libs");
+const dist = join(process.cwd(), "node_modules", "@electric-sql", "pglite", "dist");
+
+if (!existsSync(libs) || !existsSync(dist)) {
+  console.log("[pglite-data] nothing to do (no server bundle or no pglite dist)");
+  process.exit(0);
+}
+
+const bundled = readdirSync(libs).find((f) => f.includes("pglite"));
+if (!bundled) {
+  console.log("[pglite-data] no bundled pglite module found — skipping");
+  process.exit(0);
+}
+
+let copied = 0;
+for (const file of ["pglite.data", "pglite.wasm", "initdb.wasm"]) {
+  const src = join(dist, file);
+  const dest = join(libs, file);
+  if (existsSync(src) && !existsSync(dest)) {
+    copyFileSync(src, dest);
+    copied += 1;
+  }
+}
+console.log(`[pglite-data] ${copied} file(s) ensured in .output/server/_libs`);
